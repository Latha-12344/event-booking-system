# Environment variable template for the Event Booking System.
# Copy this file to .env and fill in the values.

# PostgreSQL connection string (psycopg2 driver)
DATABASE_URL=postgresql+psycopg2://postgres:password@localhost:5432/event_booking

# JWT — use a random 64-character secret in production
JWT_SECRET_KEY=change-this-to-a-random-secret-at-least-64-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Redis (broker and result backend base URL)
REDIS_URL=redis://localhost:6379/0

# Resend (real email delivery — obtain from https://resend.com)
RESEND_API_KEY=re_your_resend_api_key_here
EMAIL_FROM=noreply@yourdomain.com
